<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build. packaging/build-msix.ps1 fills in $VERSION$ from Cargo.toml
  (X.Y.Z becomes X.Y.Z.0: the Store reserves the fourth field). Identity Name, Publisher and
  PublisherDisplayName must match Partner Center > Product management > Product identity exactly.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$IDENTITY_PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Spectrum: Monitor Color Profiles Manager</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Spectrum" Executable="Spectrum.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Spectrum"
        Description="Builds ICC and HDR color profiles from your monitor's EDID and switches them from the tray."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Off until the user ticks "Start with Windows"; the app toggles it with the StartupTask API. -->
        <desktop:Extension Category="windows.startupTask" Executable="Spectrum.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--tray">
          <desktop:StartupTask TaskId="SpectrumStartup" Enabled="false" DisplayName="Spectrum" />
        </desktop:Extension>
        <!-- Lets a shell run "spectrum.exe" for the --debug-* switches and bug reports. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Spectrum.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="spectrum.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
